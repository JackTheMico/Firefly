---
// ZZZ Fast-Router Compass Navigation Grid (Inspired by fqzlr.com)
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

interface CompassItem {
	label: string;
	subLabel: string;
	href: string;
	icon: string;
}

const compassItems: CompassItem[] = [
	{
		label: "文章记录",
		subLabel: "POSTS",
		href: "/posts/",
		icon: "material-symbols:article-outline",
	},
	{
		label: "时间归档",
		subLabel: "ARCHIVE",
		href: "/archive/",
		icon: "material-symbols:archive-outline",
	},
	{
		label: "委托分类",
		subLabel: "CATEGORIES",
		href: "/categories/",
		icon: "material-symbols:folder-outline",
	},
	{
		label: "以太标签",
		subLabel: "TAGS",
		href: "/tags/",
		icon: "material-symbols:label-outline",
	},
	{
		label: "绳网动态",
		subLabel: "MOMENTS",
		href: "/dynamic/",
		icon: "material-symbols:bolt",
	},
	{
		label: "影像胶卷",
		subLabel: "GALLERY",
		href: "/gallery/",
		icon: "material-symbols:photo-library-outline",
	},
	{
		label: "阵营联络",
		subLabel: "FRIENDS",
		href: "/friends/",
		icon: "material-symbols:group-outline",
	},
	{
		label: "特级绳匠",
		subLabel: "ABOUT",
		href: "/about/",
		icon: "material-symbols:info-outline",
	},
];
---

<section class="home-compass card-base p-4 mb-4 onload-animation" aria-label="绳网快速导航">
  <!-- Compass Header -->
  <header class="flex items-center justify-between pb-3 mb-3 border-b border-white/10 dark:border-white/10">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-4 bg-(--primary) rounded-[1px]"></span>
      <h2 class="font-mono font-bold text-base md:text-lg text-neutral-100 tracking-wide flex items-center gap-2">
        <span>快速带你前往</span>
        <span class="text-neutral-500 font-normal text-xs">// ROUTER</span>
      </h2>
      <span class="text-xs text-neutral-400 hidden sm:inline-block">你想去的地方</span>
    </div>
    <div class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[0.68rem] font-mono font-bold tracking-widest text-(--primary) bg-(--primary)/10 border border-(--primary)/30 rounded-[2px]">
      <span class="w-1.5 h-1.5 rounded-full bg-(--primary) animate-pulse"></span>
      <span>DIRECTORY // 08</span>
    </div>
  </header>

  <!-- Compass Grid -->
  <nav class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2.5" aria-label="站点核心导航">
    {
      compassItems.map((item) => (
        <a
          href={url(item.href)}
          class="home-compass-item group relative flex flex-col items-center justify-center p-2.5 rounded-[4px] bg-black/30 dark:bg-black/40 border border-white/10 hover:border-(--primary) hover:bg-(--primary)/10 transition-all duration-200 active:scale-95"
          aria-label={item.label}
        >
          <div class="mb-1.5 p-2 rounded-full bg-white/5 group-hover:bg-(--primary)/20 text-neutral-300 group-hover:text-(--primary) transition-colors shadow-inner">
            <Icon is:inline name={item.icon} class="text-xl" />
          </div>
          <span class="font-bold text-xs text-neutral-200 group-hover:text-(--primary) transition-colors tracking-wide">
            {item.label}
          </span>
          <span class="font-mono text-[0.62rem] text-neutral-400 group-hover:text-(--primary)/80 transition-colors tracking-widest uppercase">
            {item.subLabel}
          </span>
          <!-- Corner brackets on hover -->
          <span class="absolute top-1 left-1 w-1.5 h-1.5 border-t border-l border-(--primary) opacity-0 group-hover:opacity-100 transition-opacity"></span>
          <span class="absolute bottom-1 right-1 w-1.5 h-1.5 border-b border-r border-(--primary) opacity-0 group-hover:opacity-100 transition-opacity"></span>
        </a>
      ))
    }
  </nav>
</section>

<style>
  .home-compass-item {
    clip-path: polygon(
      0 4px,
      4px 0,
      100% 0,
      100% calc(100% - 4px),
      calc(100% - 4px) 100%,
      0 100%
    );
  }
</style>
